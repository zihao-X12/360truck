# Docker 部署变量模板
#
# 用法（在项目根目录执行）：
#   cp .env.deploy.example .env      # 然后修改下面的口令
#   docker compose -f docker-compose.my.yml up -d --build
#
# 说明：
#   - 该文件由 compose 自动读取，因此无需每次追加 --env-file 参数。
#   - 生产环境必须改成强口令；这些值不会写入镜像，仅在启动时注入容器。
#   - 变量缺失或为空时 compose 会直接报错拒绝启动（fail-fast），避免用默认弱口令上线。

# MySQL root 口令（docker-compose.my.yml 使用）
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# PostgreSQL 口令（docker-compose.pg.yml 使用；仅用 MySQL 时可留占位值）
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 后端连接数据库使用的口令，需与上面保持一致
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 数据库名与账号（如与默认值不同才需要取消注释并修改）
DB_DATABASE=truck_bank
DB_USERNAME=root

# JWT 签名密钥，生产环境必须替换为随机长字符串
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_RANDOM_LONG_SECRET
