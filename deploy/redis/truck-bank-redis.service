[Unit]
Description=Truck Bank Redis (bundled 7.4.2)
Documentation=file:/opt/truck-bank/redis/redis.conf
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/opt/truck-bank/redis/bin/redis-server /opt/truck-bank/redis/redis.conf
ExecStop=/opt/truck-bank/redis/bin/redis-cli -p 6379 shutdown nosave
Restart=always
RestartSec=3
LimitNOFILE=65535
TimeoutStopSec=30

# 基础加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
